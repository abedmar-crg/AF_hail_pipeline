params {
    input_dir       = "${projectDir}/input"
    output_dir      = "${projectDir}/results"
    hail_work_dir   = "${projectDir}/hail_work"
    hail_config     = "${projectDir}/config.yaml"

    final_vcf_name  = "test_afterHail.vcf.bgz"


    /*
     * ========================================================
     * OUTPUT RETENTION
     * ========================================================
     *
     * Intermediate Hail files always remain available in
     * Nextflow work/ while the cache exists.
     *
     * These switches decide which ones should ALSO be copied
     * into results/ for long-term/user-friendly access.
     */

    save_original_matrix      = true
    save_qced_matrix          = true
    save_relatedness_matrix   = true

    save_logs                 = true
    save_plots               = true
    save_ancestry_results     = true

    /*
     * Main pipeline result.
     * Keep this true by default.
     */
    save_final_vcf            = true
}



/*
 * Docker
 */
docker.enabled = true


/*
 * Final published outputs.
 */
outputDir = "${projectDir}/results"
workflow.output.mode = 'copy'


/*
 * Default process configuration.
 */
process {

    executor = 'local'

    container = 'af_hail_pipeline:latest'

    cpus = 4
    memory = '16 GB'

    /*
     * The original VCFs remain mounted at /data/input because
     * config.yaml expects paths such as:
     *
     * /data/input/converted/try/subset20000.vcf.bgz
     *
     * /data/work is now mainly for Hail/Spark temporary data.
     */
    // Bind the selected YAML explicitly into /app as a regular file.
    // This avoids broken task-workdir symlinks becoming invisible inside Docker.
    // The closure evaluates params.hail_config for every task, including CLI overrides.
    containerOptions = {
        "-v ${params.input_dir}:/data/input:ro -v ${params.hail_work_dir}:/data/work -v ${params.hail_config}:/app/config.yaml:ro"
    }
}
